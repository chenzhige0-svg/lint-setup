---
# clang-tidy —— C / C++ 静态分析
# 用法：clang-tidy --config-file=~/.config/dev-toolbox/.clang-tidy main.cpp -- -std=c++20
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity

WarningsAsErrors: ""
HeaderFilterRegex: ".*"
FormatStyle: file
SystemHeaders: false

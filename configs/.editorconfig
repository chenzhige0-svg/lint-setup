root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 99

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 2
max_line_length = 100

[*.{sh,bash}]
indent_size = 2
switch_case_indent = true
space_redirects = true
keep_padding = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab
